{
  "name": "@openfluke/lucy",
  "version": "0.2.0",
  "description": "Lucy live-fit measuring + boards \u2014 Go wasm (Node/Bun) and types for React/Angular",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
