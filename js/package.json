{
  "name": "@openfluke/lucy",
  "version": "0.5.0",
  "description": "Lucy live-fit measuring + boards (wasm/native/serve, React, Angular CE, PNG/JPG reports)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./react": {
      "import": "./src/react/index.js"
    },
    "./charts": {
      "import": "./src/charts/index.js"
    },
    "./elements": {
      "import": "./src/elements/lucy-board.js"
    },
    "./serve": {
      "import": "./src/serve.js"
    }
  },
  "files": [
    "src",
    "wasm",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "bash ../go/scripts/build-artifacts.sh",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "lucy",
    "lpd",
    "pareto",
    "welvet",
    "tide",
    "live-fit",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfluke/lucy.git",
    "directory": "js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
